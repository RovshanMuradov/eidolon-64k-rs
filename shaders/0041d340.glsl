float Bump(vec3 offset,Ray ray,Sample sampl){vec3 point=sampl.intersection+offset;if(sampl.materialId.w==6.0){float w=max(0.0,1.0-sampl.fog*1.5);float bubbles=vmin(texture(sTD2DInputs[5],point.yz*0.02))*w;point.z=0.0;float tex=texture(sTD2DInputs[0],point.yz*0.1).x;tex=smoothstep(0.4,0.6,texture(sTD2DInputs[0],tex*0.3+point.yz*0.1).w);return (tex+bubbles)*w*0.01;}float a=texture(sTD2DInputs[0],point.xz*0.3).x;float b=texture(sTD2DInputs[0],point.xz*0.05).x;float o=0.0;if(sampl.materialId.w<=1.0){float land=a*0.15+b*2.0;float water=a*0.01+b*0.05;o=mix(land,water,sampl.materialId.w);}else if(sampl.materialId.w==5.0)
{float n=sum(texture(sTD2DInputs[0],point.xz*0.15).xz*vec2(0.4,0.01));float x=abs(sampl.materialId.x+offset.z);float stripes=CalcStripes(sampl.materialId.xz+offset.xz);float n1=sum(texture(sTD2DInputs[0],point.xz*0.06).xy);float reflectivity=smoothstep(0.5,0.7,0.5*n1);o=mix(n,0.0,stripes*0.03)*(1.0-reflectivity*0.95);}o*=(1.0-sampl.fog);return o;}
