float Bump(vec3 offset,Ray ray,Sample sampl){float bump=0.;if(sampl.materialId.w<10.0){if(sampl.materialId.w==1.0)return 0.0;vec3 point=sampl.materialId.xyz+offset;vec2 uv=point.xy;if(abs(sampl.normal.x)>abs(sampl.normal.z)){uv.x=point.z;}vec4 t=texture(sTD2DInputs[2],uv*0.2);bump=t.z*0.05*(1.0-max(0.0,sampl.normal.y));if(sampl.materialId.w==3.0){t=texture(sTD2DInputs[2],point.xz*0.3);bump+=t.x*0.1+t.y*0.01;}}if(sampl.materialId.w==2.0 && sampl.normal.y<-0.5){bump*=sqr(1.0-sampl.fog);}return bump;}
