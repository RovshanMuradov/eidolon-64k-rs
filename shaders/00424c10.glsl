vec4 FogColor(vec3 direction){vec3 tex=texture(sTD2DInputs[4],direction.xy*0.2/uFovBias).xxx;tex+=texture(sTD2DInputs[4],direction.xy*0.3/uFovBias).xxx*0.5;tex+=texture(sTD2DInputs[4],direction.xy*0.4/uFovBias).xxx*0.25;return vec4(tex,2.0);}Material GetMaterial(Ray ray,Sample sampl){Material result=Material(vec3(0.0),0.0,0.0,0.0,vec3(0.0));vec4 tex1=texture(sTD2DInputs[0],sampl.intersection.xy*vec2(0.01,0.03)+0.5-uTime*0.0003),tex=texture(sTD2DInputs[0],sampl.intersection.xy*0.1+sampl.normal.yx*0.1+tex1.w*0.5+uTime*0.006);if(sampl.materialId.w==0.0){float noise=(tex.x+tex.y+tex.w)/3.0;result.albedo=mix(vec3(0.7,0.7,0.7),vec3(0.1,0.1,0.1),smoothstep(0.2,0.8,noise));}else if(sampl.materialId.w==1.0)
{result.additive=vec3(0.8,0.9,0.8)*cub(smoothstep(1.5,-0.5,sampl.materialId.x-cub(tex1.z)*tex.y));result.additive+=FogColor(ray.direction*2.0).xyz*0.5;}else if(sampl.materialId.w==2.0)
{result.additive=vec3(0.78,0.69,0.37)*15.0;}else if(sampl.materialId.w==80.0)
{result=Material(vec3(0.0),0.0,0.1,0.0,(vec3(0.2,1.0,0.3)+hash12(sampl.materialId.xy))*4.0*(sampl.materialId.x+1.05));}return result;}
