vec2 wrap(vec2 n,float period){return vec2(n.x>=0.0 ? mod(n.x,period) : period+n.x,n.y>=0.0 ? mod(n.y,period) : period+n.y);}vec4 voronoiFastWrap(vec2 x,float per){vec2 n=floor(x);vec2 f=fract(x);vec2 mr,s;float md=8.0;for( int j=-1;j<=1;j++)for( int i=-1;i<=1;i++){vec2 g=vec2(float(i),float(j));vec2 gn=wrap(n+g,per);vec2 o=hash22(gn);vec2 r=g+o-f;float d=dot(r,r);if( d<md ){md=d;mr=r;s=g+n;}}md=8.0;for( int j=-1;j<=1;j++)for( int i=-1;i<=1;i++){vec2 g=vec2(float(i),float(j));vec2 gn=wrap(n+g,per);vec2 o=hash22(gn);vec2 r=g+o-f;if(dot(mr-r,mr-r)>EPSILON)md=min( md,dot( 0.5*(mr+r),normalize(r-mr) ) );}return vec4(md,mr,hash12(s));}vec4 Shade(vec2 uv){uv=abs(uv*2.0-1.0);vec4 vf=voronoiFastWrap(uv*5.0,5.0);return vec4(length(vf.yz),vf.x,vf.w,0.0);}
