vec3 Lighting(LightData data){vec3 result=vec3(0.0);result+=PointLight(data,uMainCharacterPos+vec3(0.0,0.2,0.0),vec4(uMainBotMood,3.0),0.0,16.0);result+=PointLight(data,vec3(-1.5,3.5,2.5),vec4(vec3(0.2,0.5,0.8)*0.3,1.5),0.0,8.0);result+=PointLight(data,vec3(0.0,4.5,-2.5),vec4(vec3(0.3)*0.4,0.6),0.0,8.0);result+=PointLight(data,vec3(2.0,3.,0.5),vec4(vec3(0.8,0.8,0.8)*1.0,3.0),0.0,8.0);result+=PointLight(data,vec3 (0.0,3.5,-4.0),vec4(vec3(saturate(-uHabitatDoor*0.3)*5.0),1.0),0.0,8.0);return result;}
