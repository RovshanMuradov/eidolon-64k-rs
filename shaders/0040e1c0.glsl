uniform vec2 offset=vec2(0.0,8.0);uniform vec2 scale=vec2(3.0);uniform int octaves=10;uniform float sizeFactor=2.0;uniform float weightFactor=0.5;float Perlin(vec2 uv){uv=uv*scale+offset;float totalWeight=1.0;float value=snoise(uv);float weight=1.0;for(int i=0;i<octaves;++i){uv*=sizeFactor;weight*=weightFactor;value+=snoise(uv)*weight;totalWeight+=weight;}return value/totalWeight;}vec4 Shade(vec2 uv){return vec4(Perlin(uv),Perlin(uv*8.0),Perlin(uv*40.0),Perlin(uv*20.0));}
