float MT_Bump(vec3 point,Ray ray,Sample result){if(result.materialId.w==0.0 || result.materialId.w==2.0){return textureTri(sTD2DInputs[2],(result.intersection+point)*vec3(1.0,1.0,0.1),result.normal).z*0.035*saturate(1.0-result.fog*2.0);}return 0.0;}float Bump(vec3 offset,Ray ray,Sample sampl){if(sampl.materialId.w>=90.0){return 0.0;}if(sampl.materialId.w==5.0){return 0.0;}if(sampl.materialId.w<4.0){return MT_Bump(offset,ray,sampl);}vec3 point=sampl.intersection+offset;return textureTri(sTD2DInputs[0],point*0.1,sampl.normal).x*2.0;}
