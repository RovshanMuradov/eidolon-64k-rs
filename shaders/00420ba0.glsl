Material GetMaterial(Ray ray,Sample sampl){Material result=Material(vec3(0.2),0.0,0.0,0.0,vec3(0.0));float sRand=sin(sampl.materialId.x*4.0+sampl.materialId.z*0.1+sampl.materialId.x*sampl.materialId.x*uTime*0.8);if(sampl.materialId.w==2.0){result.additive=(1.0-sampl.fog)*mix(vec3(0.0,1.0,4.0),vec3(0.0,4.0,1.0),sampl.materialId.y)*max(0.0,sin(atan(sampl.intersection.x,sampl.intersection.y)*35.0))*smoothstep(0.99,1.08,sRand);result.additive*=saturate(1.0+dot(sampl.normal,ray.direction));}else if(sampl.materialId.w==1.0)
{result.albedo=vec3(0.1);result.reflectivity=0.0;result.roughness=0.03;result.additive=(1.0-sampl.fog)*mix(vec3(0.0,1.0,4.0),vec3(0.0,4.0,1.0),sampl.materialId.y)*smoothstep(0.999,1.0,sRand);result.additive+=cub(saturate(0.7+dot(sampl.normal,ray.direction)))*vec3(0.0,0.1,0.15);}else if(sampl.materialId.w==0.0)
{result=Material(vec3(1.0,0.6,0.4),0.3,0.2,1.0,vec3(0.03,0.01,0.05)*0.25);}result.additive+=pow(saturate(dot(reflect(ray.direction,sampl.normal),saturate(vec3(0.0,0.8,0.3)))),10.0)*vec3(0.0,0.5,1.0)*textureTri(sTD2DInputs[0],sampl.intersection*vec3(0.03,0.03,0.5),sampl.normal).y;mtlMainBot(ray,sampl,result);return result;}
