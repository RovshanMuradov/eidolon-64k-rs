vec3 MT_Lighting(LightData data){vec3 result=vec3(0.0);float z=round(data.intersection.z/3.3333);float rad=hash11(z);z*=3.3333;data.intersection.y-=0.2;result+=PointLightNoSpec(data,vec3(0.0,1.15,z),vec4(vec3(2.0),5.0),0.0,0.0);data.intersection.y-=0.8;result+=PointLight(data,uMainCharacterPos+vec3(0.0,0.2,0.0),vec4(uMainBotMood,1.0),0.0,16.0);return result;}vec3 MS_Lighting(LightData data){vec3 result=vec3(0.0);result+=PointLight(data,uMainCharacterPos+vec3(0.0,0.2,0.0),vec4(uMainBotMood*6.0,0.8),0.0,16.0);float id=pMod1(data.intersection.y,70.0);pR(data.intersection.xz,hash11(id)*TAU);result+=PointLight(data,vec3(0.0,-7.0,70.0),vec4(vec3(1.0,5.0,7.0),0.1),0.0,1.0);return result;}vec3 Lighting(LightData data){vec3 result=mix(MS_Lighting(data),MT_Lighting(data),uMaintenanceTunnel);return result;}
