vec3 LandscapeAlbedo(Sample sampl,float sand){float m=texture(sTD2DInputs[0],sampl.intersection.xz*0.02).x;float n=texture(sTD2DInputs[0],sampl.intersection.xz*0.08+m*4.0+sampl.intersection.y*0.2).x;vec3 landscapeAlbedo;landscapeAlbedo=mix(vec3(0.84,0.68,0.44),vec3(0.2,0.18,0.1),clamp(sampl.materialId.y+sand+m,0.0,1.0));landscapeAlbedo+=(smoothstep(0.6,0.8,n)*0.6+pow(m,2.0)*2.0)*vec3(0.2,0.17,0.2);landscapeAlbedo+=vec3(0.5,0.5,0.45)*saturate(-sampl.materialId.x*sampl.intersection.y*0.005);return landscapeAlbedo;}float CalcStripes(vec2 p){float x=abs(p.x);pMod1(p.y,3.0);p=abs(p);pR45(p);const float a=0.4;const float b=0.7;float stripes=max(max(a-x,x-b),abs(p.x-0.7)*0.7);stripes=min(max(p.y+0.32,abs(x-b)),stripes);stripes=min(max(0.16-p.y,abs(x-a)),stripes);stripes=saturate(3.0-stripes*100.0);return stripes;}float BumpCorridor(float scale,vec3 offset,Ray ray,Sample sampl){vec3 is=sampl.materialId.xyz*scale;float bump=0.;if(sampl.materialId.w<10.0){if(sampl.materialId.w==1.0)return 0.0;vec3 point=is+offset;vec2 uv=point.xy;if(abs(sampl.normal.x)>abs(sampl.normal.z))uv.x=point.z;vec4 t=texture(sTD2DInputs[2],uv*0.2);bump=t.z*0.1*(1.0-max(0.0,sampl.normal.y));if(sampl.materialId.w==3.0){t=texture(sTD2DInputs[2],point.xz*0.3);bump+=t.x*0.1+t.y*0.01;}}return bump;}uniform vec3 uMainBotMood=vec3(1.2,1.6,2.4);void mtlMainBot(Ray ray,Sample sampl,inout Material result){float w=texture(sTD2DInputs[0],sampl.materialId.yz*0.1).y;if(sampl.materialId.w==10.0){result=Material(vec3(0.0),0.0,0.0,0.0,vec3(1.0));}else if(sampl.materialId.w==90.0)
{if(abs(sampl.materialId.x)-0.5>0.0){result=Material(vec3(0.95,0.6,0.3),0.3,0.1,0.6,vec3(0.0));}else{result=Material(w*vec3(0.8,0.45,0.45)+0.12,0.0,0.1,0.6,vec3(0.0));vec2 uv=sampl.materialId.xz*vec2(1.0,sign(sampl.materialId.y))*2.2;float c=smoothstep(0.55,0.56,abs(abs(uv.x)+uv.y*1.5)-0.6);result.albedo=mix(vec3(1.4),result.albedo,c);result.additive=mix(vec3(0.06,0.01,0.02),result.additive,c);}}else if(sampl.materialId.w==91.0)
