Material GetMaterial(Ray ray,Sample sampl){Material result=Material(vec3(0.0),0.0,0.1,0.0,vec3(0.0));if(sampl.materialId.w<=1.0){vec3 landscapeAlbedo=LandscapeAlbedo(sampl,12.5);landscapeAlbedo=mix(vec3(1.0),landscapeAlbedo,saturate(sampl.intersection.y+13.0));landscapeAlbedo.yz=mix(landscapeAlbedo.yz,vec2(0.8,0.7),sampl.materialId.w);vec3 waterAlbedo=vec3(0.0,0.4,0.5);result.albedo=mix(landscapeAlbedo,waterAlbedo,sampl.materialId.w);result.roughness=0.0;}else if(sampl.materialId.w==2.0)
{result.albedo=vec3(0.5);}else if(sampl.materialId.w==3.0)
{result.additive=vec3(1.0,2.0,4.0);}else if(sampl.materialId.w==4.0)
{result.albedo=vec3(0.2,0.15,0.2);result.additive=vec3(1.0,2.0,4.0)*smoothstep(0.8,1.0,cos(sampl.materialId.y*30.0));}else if(sampl.materialId.w==5.0 || sampl.materialId.w==10.0 || sampl.materialId.w==9.0 || sampl.materialId.w==8.0)
{float n=sum(texture(sTD2DInputs[0],sampl.intersection.xz*0.06).xy);result.albedo=vec3(0.2)*n;float x=abs(sampl.materialId.x);result.reflectivity=0.5*max(0.0,sampl.normal.y)*smoothstep(0.59,0.7,0.5*n);if(sampl.materialId.w !=8.0){float stripes=CalcStripes(sampl.materialId.xz);result.albedo+=vec3(1.4,1.0,0.0)*stripes;}else{result.albedo*=3.0;result.reflectivity=0.0;}}else if(sampl.materialId.w==6.0)
{float bubbles=vmin(texture(sTD2DInputs[5],sampl.intersection.yz*0.05));float tex=texture(sTD2DInputs[0],sampl.intersection.yz*0.1).x;tex=texture(sTD2DInputs[0],tex*0.3-bubbles*0.1+sampl.intersection.yz*vec2(0.15,0.03)).y*tex;result.albedo=vec3(1.0)+tex;result.reflectivity=0.4;result.roughness=0.05;result.additive=vec3(0.0,0.05,0.07);}else if(sampl.materialId.w==7.0)
{result.albedo=vec3(0.7);result.additive=vec3(0.0,0.05,0.07);}mtlMainBot(ray,sampl,result);return result;}
