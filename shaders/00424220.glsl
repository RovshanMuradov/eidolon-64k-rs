float MBoxDf(vec3 n){vec3 c=fract(n*.0015);vec3 d=abs(.5-c)-.5;float b=1.0;float e=vmax(d);for (int i=0;i<7;++i){d=.5-abs(.5-fract(c*b))*3.0;b*=3.0;e=max(min(max(d.x,d.z),min(max(d.x,d.y),max(d.y,d.z)))/b,e);}b=smoothstep(0.07,0.1,abs(.5-fract(e*900.0))-.4);return b;}Material GetMaterial(Ray ray,Sample sampl){Material result=Material(vec3(.5),0.0,0.0,0.0,vec3(0.0));vec4 tex=textureTri(sTD2DInputs[0],sampl.intersection*0.01,sampl.normal);if(sampl.materialId.w==0){result=Material(mix(vec3(0.5,0.4,0.3),vec3(0.5),tex.y),0.0,0.0,0.0,vec3(0.0));}else if(sampl.materialId.w==1)
{result=Material(tex.www*0.2+vec3(0.4,0.15,0.2),0.0,0.0,0.0,vec3(0.0));}else if(sampl.materialId.w==5)
{result=Material(vec3(0.2,0.4,0.5),0.0,0.0,0.0,vec3(0.0));}if(sampl.materialId.w==200){result.albedo=vec3(0.1,0.7,0.8)*4.0;sampl.materialId.xy+=-uTime*0.1678;sampl.materialId.xy=sin(sampl.materialId.xy*2.);result.additive+=smoothstep(0.1,0.25,textureTri(sTD2DInputs[2],sampl.materialId.xyz*vec3(0.8),sampl.normal).x)*1.;sampl.materialId.xy+=uTime*1.;result.additive*=smoothstep(0.1,0.25,textureTri(sTD2DInputs[2],sampl.materialId.xyz*vec3(0.3),sampl.normal).x)*vec3(0.1,0.7,0.8)*0.5;}else if(sampl.materialId.w>=201)
{float anim=saturate(sampl.materialId.w-201.0);result.albedo=(vec3(0.4,0.9,1.0)*4.0);result.albedo+=textureTri(sTD2DInputs[5],sampl.materialId.xyz*vec3(0.075)+(uTime*0.005),sampl.normal).x*2.0;result.reflectivity=0.5;result.roughness=0.95;}mtlMainBot(ray,sampl,result);return result;}
