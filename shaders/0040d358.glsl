vec4 hash44(vec4 p4){p4=fract(p4*vec4(1031,.1030,.0973,.1099));p4+=dot(p4,p4.wzxy+19.19);return fract((p4.xxyz+p4.yzzw)*p4.zywx);}vec4 hash41(float p){return hash44(vec4(p));}vec4 hash42(vec2 p){return hash44(p.xyxy);}vec4 hash43(vec3 p){return hash44(p.xyzx);}vec3 hash34(vec4 p){return hash44(p).xyz;}vec3 hash31(float p){return hash34(vec4(p));}vec3 hash32(vec2 p){return hash34(p.xyxy);}vec3 hash33(vec3 p){return hash34(p.xyzx);}vec2 hash24(vec4 p){return hash44(p).xy;}vec2 hash21(float p){return hash24(vec4(p));}vec2 hash22(vec2 p){return hash24(p.xyxy);}vec2 hash23(vec3 p){return hash24(p.xyzx);}float hash14(vec4 p){return hash44(p).x;}float hash11(float p){return hash14(vec4(p));}float hash12(vec2 p){return hash14(p.xyxy);}float hash13(vec3 p){return hash14(p.xyzx);}uint uhash14(vec4 p){return uint(floor(hash14(p)*INTEGER_HASH_RANGE));}uint uhash11(float p){return uint(floor(hash11(p)*INTEGER_HASH_RANGE));}uint uhash12(vec2 p){return uint(floor(hash12(p)*INTEGER_HASH_RANGE));}uint uhash13(vec3 p){return uint(floor(hash13(p)*INTEGER_HASH_RANGE));}float snoise(vec3 x){vec3 p=floor(x);vec3 f=fract(x);f=f*f*(3.0-2.0*f);float n=p.x+p.y*157.0+113.0*p.z;return mix(mix(mix(hash11(n),hash11(n+1.0),f.x),mix(hash11(n+157.0),hash11(n+158.0),f.x),f.y),mix(mix(hash11(n+113.0),hash11(n+114.0),f.x),mix(hash11(n+270.0),hash11(n+271.0),f.x),f.y),f.z);}float snoise(vec2 x){vec2 p=floor(x);vec2 f=fract(x);f=f*f*(3.0-2.0*f);float n=p.x+p.y*157.0;return mix(mix(hash11(n),hash11(n+1.0),f.x),mix(hash11(n+157.0),hash11(n+158.0),f.x),f.y);}float snoise(float x){float n=floor(x);float f=fract(x);f=f*f*(3.0-2.0*f);return mix(hash11(n),hash11(n+1.0),f);}float perlin(vec3 x){return (snoise(x)+snoise(x*2.0)*0.6+snoise(x*7.0)*0.3)/1.9;}float perlin(vec2 x){return (snoise(x)+snoise(x*2.0)*0.6+snoise(x*7.0)*0.3)/1.9;}float perlin(float x){return (snoise(x)+snoise(x*2.0)*0.6+snoise(x*7.0)*0.3)/1.9;}vec4 voronoiFast(vec2 x){vec2 n=floor(x);vec2 f=fract(x);vec2 mr,s;float md=8.0;for( int j=-1;j<=1;j++)for( int i=-1;i<=1;i++){vec2 g=vec2(float(i),float(j));vec2 o=hash22(n+g);vec2 r=g+o-f;float d=dot(r,r);if( d<md ){md=d;mr=r;s=g+n;}}md=8.0;for( int j=-1;j<=1;j++)for( int i=-1;i<=1;i++){vec2 g=vec2(float(i),float(j));vec2 o=hash22( n+g );vec2 r=g+o-f;if(dot(mr-r,mr-r)>EPSILON)md=min( md,dot( 0.5*(mr+r),normalize(r-mr) ) );}return vec4(md,mr,hash12(s));}float smoothNoise21(vec2 p){vec2 f=fract(p);p-=f;f*=f*(3.-f-f);return dot(mat2(fract(sin(vec4(0,1,27,28)+p.x+p.y*27.)*1e5))*vec2(1.-f.y,f.y),vec2(1.-f.x,f.x));}float fractalNoise21(vec2 p,float modifier,int choice){if(choice==0){return smoothNoise21(p)*0.5333+smoothNoise21(p*2.)*0.2667+smoothNoise21(p*4.)*0.1333+smoothNoise21(p*8.)*0.0667*modifier;}if(choice==1){return smoothNoise21(p)*0.57+smoothNoise21(p*2.45)*0.28+smoothNoise21(p*6.)*0.15*modifier;}if(choice==2){return smoothNoise21(p)*0.65+smoothNoise21(p*4.)*0.35*modifier;}}float warpedNoise21(vec2 p,vec2 animate,vec3 warp_xyz){vec2 m=vec2(animate.x,-animate.y)*0.5;float x=fractalNoise21(p+m,warp_xyz.x,0);float y=fractalNoise21(p+m.yx+x,warp_xyz.y,0);float z=fractalNoise21(p-m-x+y,warp_xyz.z,0);return fractalNoise21(p+vec2(x,y)+vec2(y,z)+vec2(z,x)+length(vec3(x,y,z))*0.25,1.0,0);}vec3 warpedNoise21 (vec2 uv,float sample_distance,float zoom,float highlight_1,float highlight_2,vec2 time,vec3 warp_xyz,vec3 highlight_col){vec3 color=vec3(0.0);float n=warpedNoise21(uv*zoom,vec2(time),vec3(warp_xyz));float n2=warpedNoise21(uv*zoom+sample_distance,vec2(time),vec3(warp_xyz));float bump=(n2*n2-n*n)*highlight_1;vec3 col=(n)+highlight_col*bump*bump*highlight_2;return col;}
