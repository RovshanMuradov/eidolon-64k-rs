float sum(vec2 x){return x.x+x.y;}vec2 ManhattanVoronoi(vec2 uv){float t=2.0;float b=0.0;for(int i=0;i<32;++i){vec2 p=hash21(float(i));float l=2.0;for(int j=-1;j<=1;++j){for(int k=-1;k<=1;++k){vec2 d=abs(p-uv+vec2(j,k));l=min(l,d.x+d.y);}}if(l<t){t=l;b=float(i)*33.081;}}return vec2(t,b);}float Greeble(vec2 uv,out float box){const float soft=0.003;vec2 p=uv*4.0+vec2(1.5,0.0);pMod1(p.y,0.3);float d=0.07*smoothstep(-soft,soft,-fBox2Cheap(p,vec2(0.4,0.06))/4.0);pMod1(p.y,0.1);d=min(d,1.0-1.05*smoothstep(-soft,soft,-fBox2Cheap(p,vec2(0.45,0.02))/4.0));p=uv;float c=sign(p.x);p.x=abs(p.x);p.x-=0.125;const float chamfer=0.03;float d1=0.25*min(-fBox2Cheap(p,vec2(0.12-chamfer,0.48-chamfer))/chamfer,1.0);box=0.0;if(d1>d){d=d1;box=1.0;}p.xy=abs(p.xy);p.xy-=vec2(0.07,0.43);d+=0.1*smoothstep(-soft,soft,0.01-length(p.xy));if(c>0.0){float y=uv.y;pMod1(y,0.2);d-=0.05*smoothstep(-soft,soft,0.015-abs(y));}return 0.5-d;}float Greeble4(vec2 uv,out vec3 color){vec2 uv2=fract(uv*2.0);color=vec3(0.3,0.1,0.0);if(uv.x<0.5){uv2.xy=uv2.yx;color.y+=0.1;color.z+=0.1;}if(uv.y<0.5){uv2.xy=uv2.yx;color.y+=0.1;color.z+=0.2;}float box;float d=Greeble(uv2-0.5,box);color=color*box+0.6;return d;}
