vec3 Lighting(LightData data){vec3 result=vec3(0.0);result+=PointLight(data,uMainCharacterPos+vec3(0.0,0.0,0.0),vec4(uMainBotMood,1.0),0.0,16.0);result+=DirectionalLight(data,normalize(vec3(0.5,-0.5,0.7)),vec3(0.25),0.0,8.0);result+=RimLight(data,vec3(0.1,0.3,0.4),5.0)*data.material.albedo;vec3 a=PointLight(data,vec3 (0.0,1.0,13.5),vec4(vec3(22.0,22.0,24.0)*3.0,uHangarDoorLight),1.0,64.0);if(data.material.roughness<0.0)a*=0.3;result+=a;result+=PointLight(data,vec3(-12,1.2,26),vec4(vec3(1.0,1.2,1.5),0.2),0.0,64.0);return result;}
