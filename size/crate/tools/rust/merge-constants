#!/usr/bin/env python3
"""Merge duplicate SSE/FP constants in the linked i686 PE, in place.

LLVM's MinGW COFF backend emits one constant pool per function, so the same constant is
stored many times. Every relocated absolute load `XMMWORD/QWORD/DWORD PTR ds:addr` in .text
whose bytes equal an earlier constant of compatible 16-byte alignment is redirected there;
the copies nothing reads any more are zeroed. Other references into .rdata (immediates,
indexed or based operands, data relocations) are never changed, and the 1 KiB after each of
them is left untouched in case it is a table. Values are unchanged, so code behaves the same.
usage: merge-constants file.exe
"""
import bisect
import re
import struct
import subprocess
import sys
from collections import defaultdict

SIZES = {'XMMWORD': 16, 'QWORD': 8, 'DWORD': 4}


def main(path):
    data = bytearray(open(path, 'rb').read())
    pe = struct.unpack_from('<I', data, 60)[0]
    base = struct.unpack_from('<I', data, pe + 52)[0]
    table = pe + 24 + struct.unpack_from('<H', data, pe + 20)[0]
    sections = {}
    for i in range(struct.unpack_from('<H', data, pe + 6)[0]):
        entry = table + 40 * i
        vsize, rva, rsize, raw = struct.unpack_from('<IIII', data, entry + 8)
        sections[data[entry:entry + 8].rstrip(b'\0').decode()] = (base + rva, rsize, raw)
    def offset(va):
        for start, size, raw in sections.values():
            if start <= va < start + size:
                return raw + va - start
    def inside(name, va):
        start, size, _ = sections[name]
        return start <= va < start + size
    reloc_rva, reloc_size = struct.unpack_from('<II', data, pe + 24 + 96 + 5 * 8)
    sites, p = [], offset(base + reloc_rva)
    end = p + reloc_size
    while p < end:
        page, size = struct.unpack_from('<II', data, p)
        if size == 0:
            break
        for k in range((size - 8) // 2):
            e = struct.unpack_from('<H', data, p + 8 + 2 * k)[0]
            if e >> 12 == 3:
                sites.append(base + page + (e & 0xfff))
        p += size
    listing = subprocess.run(['objdump', '-d', '-M', 'intel', '--no-show-raw-insn', '-j', '.text', path],
                             capture_output=True, text=True, check=True).stdout.splitlines()
    insns = [(int(m.group(1), 16), m.group(2)) for m in (re.match(r'^\s+([0-9a-f]+):\t(.*)$', l) for l in listing) if m]
    starts = [a for a, _ in insns]
    loads, other = defaultdict(list), []
    for site in sites:
        target = struct.unpack_from('<I', data, offset(site))[0]
        if not inside('.rdata', target):
            continue
        if inside('.text', site):
            m = re.search(r'(XMMWORD|QWORD|DWORD) PTR ds:0x([0-9a-f]+)', insns[bisect.bisect_right(starts, site) - 1][1])
            if m and int(m.group(2), 16) == target:
                loads[target].append((site, SIZES[m.group(1)]))
                continue
        other.append(target)
    width = {t: max(z for _, z in refs) for t, refs in loads.items()}
    canonical, seen = {}, defaultdict(list)
    for target in sorted(loads):
        key = bytes(data[offset(target):offset(target) + width[target]])
        hit = next((c for c in seen[key] if c % 16 == 0 or c % 16 == target % 16), None)
        if hit is None:
            seen[key].append(target)
        else:
            canonical[target] = hit
    live = set()
    for target in loads:
        if target not in canonical:
            live.update(range(target, target + width[target]))
    for target in other:
        live.update(range(target, target + 1024))
    for target, keep in canonical.items():
        for site, _ in loads[target]:
            struct.pack_into('<I', data, offset(site), keep)
        for va in range(target, target + width[target]):
            if va not in live:
                data[offset(va)] = 0
    open(path, 'wb').write(data)


if __name__ == '__main__':
    main(sys.argv[1])
